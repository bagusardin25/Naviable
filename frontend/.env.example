# ===== Naviable Backend API (Express) =====
# Local dev: http://localhost:4000 — set to the deployed backend URL in production
NEXT_PUBLIC_API_URL=http://localhost:4000

# ===== Supabase (browser client for Auth only — anon key is public) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NOTE: SUPABASE_SERVICE_ROLE_KEY and GEMINI_API_KEY live ONLY in backend/.env
# (see backend/.env.example). Never put them in the frontend.
