# Copy to backend/.env and fill in. Never commit the real .env.
# Every variable below is read by src/config.ts or src/lib/*.ts.

# ===== Data store =====
# local    = JSON file store under LOCAL_DATA_DIR. Loopback-only, no cloud setup.
#            Fine for demos and development; rejected when NODE_ENV=production.
# supabase = hosted Postgres + Storage. Required for any deployed environment.
DATA_STORE=local

# ===== Supabase (server-side only) =====
# Project URL & service_role key: Supabase Dashboard -> Project Settings -> API.
# The service_role key bypasses RLS: it must never reach the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Gemini Vision (AI checklist draft — optional) =====
# Get a key: https://aistudio.google.com/apikey
# Without it, /api/analyze degrades to a manual checklist and nothing else changes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ===== Server =====
PORT=4000
# Comma-separated origins allowed by CORS, e.g. http://localhost:3000,https://naviable.vercel.app
CORS_ORIGIN=http://localhost:3000
# Absolute URL of this API. Used to build photo links inside the CSV evidence export,
# so it must be the publicly reachable URL in production.
PUBLIC_API_URL=http://localhost:4000
# Number of reverse-proxy hops in front of the app (Railway/Render: usually 1).
# This makes rate limiting key on the real client IP. Leave 0 when directly exposed.
TRUST_PROXY_HOPS=0

# ===== Local store (DATA_STORE=local only) =====
LOCAL_DATA_DIR=.local
